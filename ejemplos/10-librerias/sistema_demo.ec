// Eclipse habla con el sistema: qué sistema es, quién eres,
// cuántos procesadores tienes y cuánta memoria.
imprimir("Sistema:", sistema());
imprimir("Usuario:", usuario());
imprimir("Carpeta:", carpeta());
imprimir("Procesadores:", procesadores());
imprimir("Memoria (MB):", memoria());
imprimir(comando("echo Hola desde el sistema"));
imprimir("La letra 65 es:", caracter(65));
