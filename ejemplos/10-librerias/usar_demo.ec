usar matematicas;
usar dibujo;

titulo("Mi demo");
imprimir("5! =", factorial(5));
imprimir("¿7 es primo?", es_primo(7));
imprimir("mcd(12, 18) =", mcd(12, 18));
imprimir("promedio =", promedio([10, 20, 30]));
imprimir("fibonacci(10) =", fibonacci(10));
