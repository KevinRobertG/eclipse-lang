// Eclipse 0.6 - Constantes y ++ / --.
// Una constante nunca cambia (ni se mueve): es una copia
// siempre. Y ++ suma 1, -- resta 1 (solo con números).
constante PI = 3.14;
constante NOMBRE = "Eclipse";
imprimir(PI);
imprimir(NOMBRE);
sea mut puntos = 0;
puntos++;
puntos++;
puntos--;
imprimir(puntos);
sea mut vidas = 3;
vidas--;
imprimir(vidas);
