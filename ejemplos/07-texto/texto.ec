// Texto y números: las funciones nuevas de la 0.7.
sea saludo = "hola kevin";
imprimir(mayusculas(saludo));
imprimir(minusculas("HOLA KEVIN"));
imprimir(contiene(saludo, "kevin"));
imprimir(contiene(saludo, "dylan"));
imprimir(redondear(3.7));
imprimir(redondear(3.2));
imprimir(absoluto(-5));
sea mut puntos = 2;
puntos **= 3;
imprimir(puntos);
imprimir(ahora() > 0);
